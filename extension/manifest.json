{
  "manifest_version": 3,
  "name": "Scheduler Helper",
  "short_name": "Scheduler",
  "version": "1.1.0",
  "description": "Brings a class list (student names and emails) from your school's Canvas into Scheduler when you ask. Keeps nothing.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://scheduler-lottery.vercel.app/*"
    ]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "homepage_url": "https://scheduler-lottery.vercel.app/helper",
  "action": {
    "default_title": "Scheduler Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  }
}
