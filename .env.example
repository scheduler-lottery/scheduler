# Copy this file to .env for local development (cp .env.example .env).
# Everything is optional locally: with nothing set, the app uses a SQLite
# file (local.db) and shows sign-in codes on screen instead of emailing them.
#
# On Vercel, set these under Project -> Settings -> Environment Variables.
# README.md explains where each value comes from.

# Required on Vercel. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Required on Vercel. Supabase -> your project -> Connect -> "Transaction pooler".
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Sign-in codes by email: WorkOS (README step 3). Its secret key, which can
# instead be pasted on /owner once the site runs.
# WORKOS_API_KEY=sk_live_...

# Optional, a mailbox of the site's own (Gmail): backups, the emails to
# professors about how sign-ups are going (half ranked, 90%, a quiet week, the
# deadline near), the owner's alerts, and sign-in codes when WorkOS can't.
# Without it those emails aren't sent. For Gmail: turn on 2-Step
# Verification, then make an "app password" at
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.sender.address@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM=          (defaults to SMTP_USER)
# SMTP_FROM_NAME=Scheduler

# You, the site owner (can always sign in; sees site-wide totals at /owner).
# OWNER_EMAIL=you@school.edu

# Who can make an instructor account. ".edu" = any address ending in .edu.
# INSTRUCTOR_EMAIL_DOMAINS=.edu

# Sign-in emails per 24 hours, site-wide. Unset: 1000 with WorkOS, 90 with
# Gmail alone (keep it under Gmail's limit).
# EMAIL_DAILY_LIMIT=

# Any long random string. Vercel sends it with the daily job's request.
# CRON_SECRET=

# The name shown in the header and in emails.
# APP_NAME=Scheduler

# Optional: an address people can write to about the site itself (shown on
# the Privacy page). Leave unset to show none.
# CONTACT_EMAIL=

# Time zone for dates in downloads and emails, until an instructor's browser
# tells us theirs.
# DEFAULT_TIMEZONE=America/Chicago

# Each class's short link at spoo.me (no ads, no key). 0 turns them off.
# SHORT_LINKS=1

# Scheduler Helper, the Chrome extension (extension/). The Chrome Web Store's
# id is built in; this adds others (a copy loaded unpacked, for testing).
# CANVAS_HELPER_IDS=
# Where "Add to Chrome" goes. Defaults to the Chrome Web Store page.
# CANVAS_HELPER_STORE_URL=
# Offer it for any school's Canvas (1 or 0). Unset: once the Chrome Web Store
# has 1.1.0, which reads any school's (helperstore.py asks Chrome's update service).
# CANVAS_HELPER_ANY_SCHOOL=

# Trying the Canvas step locally against the stand-in Canvas
# (python tools/fake_canvas.py). Ignored on Vercel.
# CANVAS_DEV_HOST=127.0.0.1:5077

# "Connect Canvas", once a school's Canvas admins issue a developer key
# (docs/northwestern-canvas-request.md). Not offered until all three are set.
# CANVAS_OAUTH_HOST=canvas.school.edu
# CANVAS_OAUTH_CLIENT_ID=
# CANVAS_OAUTH_CLIENT_SECRET=

# Where the code is published (linked from every page's footer).
# SOURCE_URL=https://github.com/scheduler-lottery/scheduler

# The credit at the foot of every page. Running your own copy? Set these to
# yourself, or BUILT_BY=- for none.
# BUILT_BY=
# BUILT_BY_EMAIL=
# BUILT_BY_URL=

# A second local database file, if you want one.
# SQLITE_PATH=local.db
