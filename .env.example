# Copy this file to .env for local development (cp .env.example .env).
# Everything is optional locally: with nothing set, the app uses a SQLite
# file (local.db) and shows sign-in codes on screen instead of emailing them.
#
# On Vercel, set these under Project -> Settings -> Environment Variables.
# README.md explains where each value comes from.

# Required on Vercel. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Required on Vercel. Supabase -> your project -> Connect -> "Transaction pooler".
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Sign-in email. For a Gmail account: turn on 2-Step Verification, then make an
# "app password" at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.sender.address@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM_NAME=Scheduler

# You, the site owner (can always sign in; sees site-wide totals at /owner).
# OWNER_EMAIL=you@school.edu

# Who can make an instructor account. ".edu" = any address ending in .edu.
# INSTRUCTOR_EMAIL_DOMAINS=.edu

# Sign-in emails per 24 hours, site-wide. Keep it under Gmail's limit.
# EMAIL_DAILY_LIMIT=90

# Any long random string. Vercel sends it with the daily job's request.
# CRON_SECRET=

# The name shown in the header and in emails.
# APP_NAME=Scheduler

# Optional: an address people can write to about the site itself (shown on
# the Privacy page). Leave unset to show none.
# CONTACT_EMAIL=

# Time zone for dates in downloads and emails, until an instructor's browser
# tells us theirs.
# DEFAULT_TIMEZONE=America/Chicago
